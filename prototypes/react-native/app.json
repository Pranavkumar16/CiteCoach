{
  "expo": {
    "name": "CiteCoach",
    "slug": "citecoach",
    "version": "0.3.2",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.citecoach.preview"
    },
    "android": {
      "package": "com.citecoach.preview",
      "versionCode": 12,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F6F4EE"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "forceCxx20": true,
          "enableOpenCL": false
        }
      ]
    ],
    "newArchEnabled": true
  }
}
